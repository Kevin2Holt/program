# progr.am configuration. Copy to .env and fill in. Never commit .env.

# PostgreSQL: the app database and a separate database used only by tests.
DATABASE_URL=postgres://progr_am:CHANGE_ME@localhost:5432/progr_am_dev
TEST_DATABASE_URL=postgres://progr_am:CHANGE_ME@localhost:5432/progr_am_test

# Public base URL used in confirmation links, emails, and calendar files.
PUBLIC_BASE_URL=https://progr.am

# Web server (production: node build). ORIGIN must match the public URL.
PORT=3000
ORIGIN=http://localhost:3000

# Mail: "log" writes emails to the console; "smtp" sends them.
MAIL_TRANSPORT=log
MAIL_FROM="progr.am <no-reply@progr.am>"
SMTP_URL=
